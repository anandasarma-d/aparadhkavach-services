<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.aparadhkavach</groupId>
  <artifactId>aparadhkavach-services</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>AparadhKavach Services</name>
  <description>Parent aggregator for the AparadhKavach Java multi-module Maven backend</description>

  <modules>
    <module>aparadhkavach-commons</module>
    <module>api-gateway-service</module>
    <module>orchestration-service</module>
    <module>investigation-service</module>
    <module>analytics-service</module>
    <module>auth-service</module>
    <module>notification-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Re-verified against repo1.maven.org/maven2 maven-metadata.xml on 16 Jul 2026
         (search.maven.org's Solr index returned stale/cached results and is not
         trustworthy here). Staying on the Spring Boot 3.5.x / Spring AI 1.0.x line
         deliberately: spring-ai-bom 2.0.0 is GA (not milestone, as originally assumed)
         but its starters depend on spring-boot-starter 4.1.0 — confirmed by inspecting
         spring-ai-starter-model-anthropic:2.0.0's POM. A Spring Boot 4.x move is a
         separate, larger decision than this version-bump fix; flagged back rather
         than made unilaterally. -->
    <spring-boot.version>3.5.16</spring-boot.version>
    <spring-ai.version>1.0.9</spring-ai.version>
    <opentelemetry-instrumentation.version>2.29.0</opentelemetry-instrumentation.version>
    <opentelemetry-instrumentation-alpha.version>2.29.0-alpha</opentelemetry-instrumentation-alpha.version>

    <spotless-maven-plugin.version>3.8.0</spotless-maven-plugin.version>
    <google-java-format.version>1.35.0</google-java-format.version>
    <!-- Pinned to 1.63.0, not the independently-newest 1.64.0: this is the exact
         opentelemetry-api version opentelemetry-instrumentation-bom:2.29.0's own
         starters declare (confirmed via opentelemetry-spring-boot-starter:2.29.0's
         POM). Root cause of the AbstractMethodError seen after the original scaffold
         build was exactly this kind of core/instrumentation version skew — the core
         alpha BOM (below) wasn't imported at all last time, so opentelemetry-api-
         incubator resolved unmanaged. -->
    <opentelemetry-api.version>1.63.0</opentelemetry-api.version>
    <opentelemetry-api-alpha.version>1.63.0-alpha</opentelemetry-api-alpha.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- OTel core + instrumentation BOMs are imported BEFORE spring-boot-dependencies,
           deliberately: Maven resolves a same-GA collision across multiple imported BOMs
           to whichever is declared FIRST in this dependencyManagement block.
           spring-boot-dependencies:3.5.16 itself pins io.opentelemetry:*  to 1.49.0 (for
           its own Micrometer Tracing OTel bridge, which none of our modules use) — with
           the old import order that silently downgraded every io.opentelemetry:* artifact
           to 1.49.0 regardless of the versions declared below, and
           opentelemetry-spring-boot-starter:2.29.0 needs 1.63.0+ (it now depends on the
           declarative-config extension, which 1.49.0 doesn't have —
           java.lang.NoClassDefFoundError: io.opentelemetry.common.ComponentLoader was the
           observed failure). Declaring these BOMs first makes them win instead. -->
      <dependency>
        <groupId>io.opentelemetry.instrumentation</groupId>
        <artifactId>opentelemetry-instrumentation-bom</artifactId>
        <version>${opentelemetry-instrumentation.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- opentelemetry-logback-mdc-1.0 (Section 9.2b) is alpha-only; the stable
           instrumentation BOM above doesn't manage it -->
      <dependency>
        <groupId>io.opentelemetry.instrumentation</groupId>
        <artifactId>opentelemetry-instrumentation-bom-alpha</artifactId>
        <version>${opentelemetry-instrumentation-alpha.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom</artifactId>
        <version>${opentelemetry-api.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Manages io.opentelemetry:opentelemetry-api-incubator, transitively required by
           opentelemetry-instrumentation-api-incubator (the alpha instrumentation BOM).
           Missing last time; that's what caused the version-skewed AbstractMethodError. -->
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom-alpha</artifactId>
        <version>${opentelemetry-api-alpha.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>dev.aparadhkavach</groupId>
        <artifactId>aparadhkavach-commons</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
          <executions>
            <execution>
              <goals>
                <goal>repackage</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Section 12.3: Spotless config lives at the root so every module in the
           reactor (aparadhkavach-commons and all 6 services) inherits it via standard
           Maven <build><plugins> inheritance -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <removeUnusedImports/>
            <formatAnnotations/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>apply</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
