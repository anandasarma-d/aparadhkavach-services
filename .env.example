# Copy to .env and fill in real values. Never commit .env itself.
# Spring Boot does not auto-load .env - export these into your shell (or your IDE's run
# config) before `mvn spring-boot:run`. Every service already boots without any of these
# set, via the local-dev placeholder defaults baked into each application.yml.

# Catalyst SDK Self Client OAuth - needed only for local/external Spring Boot access to
# Catalyst DataStore/Authentication outside a deployed AppSail context (External Services
# guide, "Catalyst SDK Access from Local/External Code"). Used by Auth, Investigation,
# Analytics, Notification, and Orchestration Service.
CATALYST_PROJECT_ID=
CATALYST_ZAID=
CATALYST_CLIENT_ID=
CATALYST_CLIENT_SECRET=
CATALYST_REFRESH_TOKEN=
CATALYST_ENVIRONMENT=Development
CATALYST_PROJECT_DOMAIN=https://api.catalyst.zoho.com

# Investigation → Analytics internal composition (Section 5.6). Default assumes Analytics
# listens on 8082 when both run locally (Investigation keeps 8080).
ANALYTICS_BASE_URL=http://localhost:8082

# API Gateway → downstream service URLs (Feature 1 routing). Distinct from the frontend's
# own env vars — read server-side by the Gateway only.
INVESTIGATION_SERVICE_URL=http://localhost:8081
ANALYTICS_SERVICE_URL=http://localhost:8082

# Voyage AI (ADR-025) - get a key from Voyage AI's dashboard (External Services
# Provisioning Guide, Tier 1). Orchestration Service only.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3-large
