{
  "command": "sh -c 'java -jar target/orchestration-service.jar --server.port=$X_ZOHO_CATALYST_LISTEN_PORT'",
  "build_path": ".",
  "stack": "java21",
  "env_variables": {
    "SERVICE_NAME": "aparadhkavach-orchestration-service",
    "NEO4J_URI": "bolt://localhost:7687",
    "NEO4J_USERNAME": "neo4j",
    "NEO4J_PASSWORD": "local-dev-placeholder-not-a-real-secret",
    "NEO4J_DATABASE": "neo4j",
    "PGVECTOR_JDBC_URL": "jdbc:postgresql://localhost:5432/postgres?sslmode=disable",
    "PGVECTOR_USERNAME": "postgres",
    "PGVECTOR_PASSWORD": "local-dev-placeholder-not-a-real-secret",
    "ANTHROPIC_API_KEY": "local-dev-placeholder-not-a-real-secret",
    "CLAUDE_MODEL": "claude-sonnet-4-6",
    "INVESTIGATION_SERVICE_URL": "http://localhost:8081",
    "QUERY_JURISDICTION": "Karnataka",
    "EMBEDDING_DIMENSIONS": "1024",
    "SARVAM_STT_URL": "http://localhost:8000",
    "STT_INTERNAL_API_KEY": "local-dev-placeholder-not-a-real-secret",
    "VECTOR_TOP_K": "5",
    "GRAPH_TRAVERSAL_DEPTH": "3",
    "CIRCUIT_BREAKER_THRESHOLD": "3",
    "VOYAGE_API_KEY": "local-dev-placeholder-not-a-real-secret",
    "EMBEDDING_MODEL": "voyage-3-large"
